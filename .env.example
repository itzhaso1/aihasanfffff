APP_NAME=HASEM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Production:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.example
# Trust X-Forwarded-* only from these comma-separated IPs/CIDRs (host .env — never commit real values).
# Same-host Nginx + PHP-FPM (documented stack): 127.0.0.1,::1,REMOTE_ADDR
# External load balancer in front of Nginx: add its private IP/CIDR. Do not use * unless the edge is guaranteed to strip client-supplied forwarded headers.
# Leave unset in local/testing so forwarded headers are ignored (prevents spoofing on direct access).
# TRUSTED_PROXIES=127.0.0.1,::1,REMOTE_ADDR

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hasem
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (requires TRUSTED_PROXIES when Nginx terminates TLS and sets X-Forwarded-Proto):
# SESSION_DRIVER=redis
# SESSION_CONNECTION=session
# SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true
# SECURITY_HEADERS_HSTS=true
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
# Production inbox realtime (Laravel Reverb):
# BROADCAST_CONNECTION=reverb
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=hasim.online
# REVERB_PORT=443
# REVERB_SCHEME=https
# REVERB_SERVER_HOST=127.0.0.1
# REVERB_SERVER_PORT=8080
# INBOX_QUEUE_INBOUND=inbound
# INBOX_QUEUE_REALTIME=realtime
# INBOX_QUEUE_AI=ai
# INBOX_QUEUE_OUTBOUND=outbound
# INBOX_QUEUE_MEDIA=media
# AI_INBOX_MEMORY_QUEUE=default
# AI_MAX_OUTPUT_CHARS=4000
# MEDIA_DISK=local
# MEDIA_DISK=s3 (production: private bucket + IAM credentials below)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
FILESYSTEM_DISK=local

# Local/testing: database queue keeps SQLite PHPUnit working without Redis.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Production (hasim.online and other hosts) — required for runtime:check --production-strict:
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# SESSION_CONNECTION=session
# REDIS_QUEUE_AFTER_COMMIT=true
# After deploy: php artisan queue:restart && supervisorctl restart hasem-worker:*
# Verify: php artisan runtime:check --production-strict --require-redis
# Do not use QUEUE_CONNECTION=failover or CACHE_STORE=failover in production.

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
# REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_SCHEME=tcp
# REDIS_SCHEME=tls
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_PREFIX=hasem-database-
# Used by `php artisan runtime:work` (combined queue list). Supervisor P0 templates use
# separate programs: hasem-worker-emails (emails), hasem-worker / inbound / ai (default).
REDIS_QUEUE=emails,default
REDIS_QUEUE_RETRY_AFTER=270
# Production (QUEUE_CONNECTION=redis): defer job push until DB transaction commits.
REDIS_QUEUE_AFTER_COMMIT=true
QUEUE_WORKER_TIMEOUT=200
QUEUE_WORKER_TRIES=3
QUEUE_WORKER_BACKOFF=5
# Isolated PHPUnit Redis namespace (never production Redis):
# REDIS_TEST_DB=14
# REDIS_TEST_PREFIX=hasem-p04-

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=
EMAIL_FROM="noreply@example.com"
CENTRAL_EMAIL_MAILER=resend
# Empty is not a credential. Production must set a real Svix signing secret or webhooks are rejected.
RESEND_WEBHOOK_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# CORS for mobile/SPA (leave empty unless a browser SPA calls the API cross-origin)
CORS_ALLOWED_ORIGINS=
CORS_SUPPORTS_CREDENTIALS=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Same URI as the website Google login. Cashier Windows uses this callback via a ticket.
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

AI_DEFAULT_PROVIDER=google_ai_studio

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=1024
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Finance Gemini Agent. Unset means agent_enabled=true and planner_fallback=true.
# FINANCE_ASSISTANT_AGENT=true
# FINANCE_ASSISTANT_PLANNER_FALLBACK=true
FINANCE_ASSISTANT_MAX_TOOL_ROUNDS=5
FINANCE_ASSISTANT_MAX_TOOL_CALLS=10

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.4
OPENAI_MAX_TOKENS=512

# Empty tokens are rejected. Do not use changeme/password/secret as production values.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PERMANENT_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v20.0
META_INSTAGRAM_OAUTH_REDIRECT_URI="${APP_URL}/workspace/channels/instagram/callback"
META_INSTAGRAM_OAUTH_SCOPES=
META_FACEBOOK_OAUTH_REDIRECT_URI="${APP_URL}/workspace/channels/facebook/callback"
META_FACEBOOK_OAUTH_SCOPES=pages_messaging,pages_show_list,pages_read_engagement
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_EMBEDDED_SIGNUP_REDIRECT_URI="${APP_URL}/workspace/channels"

PAYMENT_DEFAULT_PROVIDER=local

# Server-controlled subscription checkout provider. Never accept this from the client.
# "local" is rejected outside local/testing.
SUBSCRIPTION_CHECKOUT_PROVIDER=hyperpay
SUBSCRIPTION_CHECKOUT_TTL_HOURS=12
SUBSCRIPTION_GRACE_DAYS=3
SUBSCRIPTION_RENEWAL_LEAD_DAYS=3
# Local/testing HMAC only — not a HyperPay signature. Empty = webhook rejected (fail-closed).
SUBSCRIPTION_WEBHOOK_SECRET=
SUBSCRIPTION_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_ENABLED=false
STRIPE_KEY=
STRIPE_SECRET=
# Empty webhook secrets fail closed. Never commit a real signing key.
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
LOCAL_PAYMENT_WEBHOOK_SECRET=
LOCAL_PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# HyperPay — merchant settlement placeholder. Subscription charge/webhook API is NOT specified in-repo.
HYPERPAY_ENABLED=false
HYPERPAY_ENTITY_ID=
HYPERPAY_ACCESS_TOKEN=
HYPERPAY_CONNECT_TIMEOUT=8
HYPERPAY_TIMEOUT=20
HYPERPAY_MERCHANT_ONBOARDING_ENABLED=false
# Staging/tests only — never enable in production
HYPERPAY_MERCHANT_SANDBOX_AUTO_APPROVE=false

# Public app download URLs — leave empty until a real listing/installer exists.
# HASIM_APP_STORE_URL=
# HASIM_GOOGLE_PLAY_URL=
# HASIM_WINDOWS_DOWNLOAD_URL=
# HASIM_CHAT_APP_STORE_URL=
# HASIM_CHAT_GOOGLE_PLAY_URL=
# HASIM_CHAT_WINDOWS_DOWNLOAD_URL=
# HASIM_FINANCE_APP_STORE_URL=
# HASIM_FINANCE_GOOGLE_PLAY_URL=
# HASIM_FINANCE_WINDOWS_DOWNLOAD_URL=
# HASIM_CASHIER_APP_STORE_URL=
# HASIM_CASHIER_GOOGLE_PLAY_URL=
# HASIM_CASHIER_WINDOWS_DOWNLOAD_URL=

# Hasim mobile — push (FCM). Disabled until credentials are set.
FCM_ENABLED=false
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# Realtime: use log locally; production should use redis/reverb/pusher
# BROADCAST_CONNECTION=log

# Required before php artisan db:seed. The operator must set a strong PLATFORM_ADMIN_PASSWORD; there is no default.
PLATFORM_ADMIN_NAME="Platform Admin"
PLATFORM_ADMIN_EMAIL=admin@hasem.local
PLATFORM_ADMIN_PASSWORD=

# First-party DB backup (private disk, never public/). See docs/operations/backup-restore-runbook.md
BACKUP_DISK=backups
BACKUP_PATH=database
BACKUP_RETAIN_DAYS=14
BACKUP_PRODUCTION_DATABASE=hasem
BACKUP_SOURCE_DATABASE=hasem_p0_backup_source
BACKUP_RESTORE_DATABASE=hasem_p0_restore_drill
# BACKUP_DUMP_BINARY=
# BACKUP_MYSQL_BINARY=

# Observability / ops (P5). See docs/operations/observability-runbook.md
# OPS_CORRELATION_HEADER=X-Correlation-Id
# OPS_ALERT_INBOUND_DEPTH=500
# OPS_ALERT_REALTIME_DEPTH=200
# OPS_ALERT_AI_DEPTH=300
# OPS_ALERT_OUTBOUND_DEPTH=500
# OPS_ALERT_MEDIA_DEPTH=200
# OPS_ALERT_FAILED_JOBS_1H=25
# OPS_ALERT_WEBHOOK_5XX_RATE=5.0
# OPS_ALERT_DISK_FREE_PERCENT=10.0
# OPS_RETAIN_WEBHOOK_EVENTS_DAYS=30
# OPS_LOAD_TEST_MAX_MESSAGES=500

# TikTok Business Messaging (P6). See docs/integrations/p6-tiktok-telegram-deployment.md
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_OAUTH_REDIRECT_URI=
# TIKTOK_OAUTH_SCOPES=
# TIKTOK_WEBHOOK_CALLBACK_URL=

# Telegram Bot API (P6)
# TELEGRAM_API_BASE=https://api.telegram.org
