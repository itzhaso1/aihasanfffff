# ==============================================================================
# HASEM PRODUCTION ENVIRONMENT TEMPLATE — REAL-TIME & WEBSOCKETS (REVERB + REDIS)
# ==============================================================================
# Instructions:
# 1. Copy these entries into your production /var/www/hasem/.env file.
# 2. Generate a secure Reverb key & secret using: php artisan reverb:install (or random strings).
# 3. Ensure Supervisor has loaded deploy/supervisor/hasem-reverb.conf and hasem-worker-*.conf.
# 4. Restart services:
#    supervisorctl reread && supervisorctl update && supervisorctl restart all
# ==============================================================================

# --- BROADCASTING & REALTIME (LARAVEL REVERB) ---
BROADCAST_CONNECTION=reverb
INBOX_BROADCAST_CONNECTION=reverb

# Public client connection settings (used by Laravel Echo in browser over WSS:443)
REVERB_APP_ID=hasem_app_prod
REVERB_APP_KEY=hasem_reverb_key_prod_replace_me
REVERB_APP_SECRET=hasem_reverb_sec_prod_replace_me
REVERB_HOST=your-domain.com
REVERB_PORT=443
REVERB_SCHEME=https

# Internal daemon binding (used by artisan reverb:start on VPS)
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_SERVER_PATH=""

# Reverb Rate Limiting & Capacity
REVERB_MAX_REQUEST_SIZE=10000
REVERB_APP_MAX_CONNECTIONS=2000
REVERB_APP_MAX_MESSAGE_SIZE=10000
REVERB_APP_PING_INTERVAL=30
REVERB_APP_ACTIVITY_TIMEOUT=60
REVERB_APP_RATE_LIMITING_ENABLED=true
REVERB_APP_RATE_LIMIT_MAX_ATTEMPTS=120
REVERB_APP_RATE_LIMIT_DECAY_SECONDS=60

# --- QUEUES & JOBS (REDIS) ---
QUEUE_CONNECTION=redis
REDIS_QUEUE_AFTER_COMMIT=true

# Queues mapping matching deploy/supervisor/hasem-worker-*.conf
INBOX_QUEUE_REALTIME=realtime
INBOX_QUEUE_INBOUND=inbound
INBOX_QUEUE_OUTBOUND=outbound
INBOX_QUEUE_AI=ai
INBOX_QUEUE_MEDIA=media
AI_INBOX_MEMORY_QUEUE=default

QUEUE_WORKER_TIMEOUT=200
QUEUE_WORKER_TRIES=3
QUEUE_WORKER_BACKOFF=5

# --- CACHE & SESSION (REDIS) ---
CACHE_STORE=redis
SESSION_DRIVER=redis

# --- REDIS CONFIGURATION ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_SCHEME=tcp

# Isolated Redis databases
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_PREFIX=hasem_prod_

# --- VITE ASSET COMPATIBILITY ---
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
